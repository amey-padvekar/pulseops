# PulseOps ADK agent (Python) — Gemini + Elastic MCP.
# Copy to .env for local runs (gitignored). Never commit real keys.

# --- Vertex AI / Gemini ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
# Vertex MODEL-SERVING region (NOT your Elastic region). Gemini 2.5 is served on
# the global endpoint; asia-south1 (Mumbai) does NOT serve gemini-2.5-pro.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-pro

# --- Elastic MCP: Option A (CHOSEN) = Elastic Serverless Agent Builder MCP ---
ELASTIC_MCP_TRANSPORT=http
# IMPORTANT: this is the KIBANA host, NOT the Elasticsearch data endpoint.
ELASTIC_MCP_URL=https://your-kibana-host.kb.<region>.gcp.elastic.cloud/api/agent_builder/mcp
ELASTIC_MCP_API_KEY=<set-in-local-.env-only>
ELASTIC_MCP_AUTH_SCHEME=ApiKey
ELASTIC_MCP_TIMEOUT_SECONDS=60
# Allow-list of MCP tools exposed to Gemini (default = core read/query tools only,
# never mutating ones). Set to "all" to expose every tool the server advertises.
# ELASTIC_MCP_TOOL_FILTER=platform_core_search,platform_core_execute_esql,platform_core_generate_esql,platform_core_get_index_mapping,platform_core_list_indices,platform_core_index_explorer,platform_core_get_document_by_id

# --- Elastic MCP: Option B (local dev fallback) = standalone docker over stdio ---
# ELASTIC_MCP_TRANSPORT=stdio
# ES_URL=https://your-deployment.es.<region>.gcp.elastic.cloud:443
# ES_API_KEY=<set-in-local-.env-only>
# ES_SSL_SKIP_VERIFY=false

# --- Investigation backend selector: auto | adk | offline ---
# auto    = live when ADK+mcp installed AND an Elastic MCP endpoint is configured
# adk     = force the live Gemini+MCP path
# offline = force the deterministic baseline
AGENT_INVESTIGATION_BACKEND=auto
