# Backend runtime
APP_ENV=development
LOG_LEVEL=info
BACKEND_PORT=8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Incident handling defaults
INCIDENT_VALIDATION_WINDOW_SECONDS=20

# Set the real values in backend/.env (gitignored) — never commit them here.
ELASTIC_ENDPOINT=https://your-deployment.es.<region>.gcp.elastic.cloud:443
ELASTIC_API_KEY=<set-in-local-.env-only>
ELASTIC_INDEX_TELEMETRY=telemetry-events
ELASTIC_INDEX_INCIDENTS=incident-events
ELASTIC_INDEX_LOGS=endpoint-logs
ELASTIC_ENABLED=true
# Agent Builder / Gemini orchestration.
# Transport selector: agent_engine | adk | http. Default: agent_engine if
# AGENT_ENGINE_RESOURCE is set, else adk if ADK endpoint set, else http.
# AGENT_BUILDER_TRANSPORT=agent_engine
#
# Vertex AI Agent Engine (the deployed Gemini + Elastic MCP agent, W3). Project
# and location are inferred from the resource path if not set separately. The
# backend authenticates with Application Default Credentials (cloud-platform scope):
# `gcloud auth application-default login` locally, or the Cloud Run service account.
AGENT_ENGINE_RESOURCE=projects/your-project/locations/us-central1/reasoningEngines/<id>
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=us-central1
#
# Legacy HTTP/ADK transports (only used when transport=http|adk):
AGENT_BUILDER_ENDPOINT=https://your-agent-builder-endpoint.example.com
AGENT_BUILDER_AUTH=<set-in-local-.env-only>
# Timeout per investigation. agent_engine defaults to 60000ms if unset (Gemini+MCP latency).
AGENT_BUILDER_TIMEOUT_MS=10000
# Phase 11: timeout budget for one final-summary generation attempt. On timeout or
# malformed output the backend stores a deterministic fallback summary instead.
AGENT_BUILDER_SUMMARY_TIMEOUT_MS=12000
AGENT_BUILDER_ENABLED=false
# Offline fallback when the agent endpoint is unreachable (demo/dev only). Unset for prod.
#   local_stub         = empty recommendation; incident stays investigating (not approvable)
#   local_stub_actions = deterministic restart_service recommendation; promotes to
#                        awaiting_approval so the Phase 8 approval gate can be demoed offline
# AGENT_BUILDER_FALLBACK_MODE=local_stub_actions
#
# Demo Mode: gates the additive, judge-facing "Simulate Service Failure" endpoints
# (/demo/incident, /demo/reset). Off by default; the normal (non-demo) flow is unaffected.
DEMO_MODE=false
